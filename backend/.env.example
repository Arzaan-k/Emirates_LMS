# ==========================================
# LMS Backend Environment Variables
# ==========================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# ==========================================
# REQUIRED - Server will not start without these
# ==========================================

# PostgreSQL Database URL (Neon, Supabase, Railway, etc.)
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# Groq API Key for AI features (transcription, quiz generation, etc.)
GROQ_API_KEY=gsk_your_groq_api_key_here

# ElevenLabs API Key for Text-to-Speech
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# JWT Secret Key (generate a strong random string)
# Use: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# ==========================================
# OPTIONAL - Have sensible defaults
# ==========================================

# Environment (development, staging, production)
ENVIRONMENT=development

# Server Configuration
PORT=8000
HOST=0.0.0.0

# External URL (set by Render automatically, or set manually)
# Used for generating file URLs, WebSocket connections, etc.
RENDER_EXTERNAL_URL=https://your-app.onrender.com

# ==========================================
# AUTHENTICATION
# ==========================================

# JWT Token Expiration
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# ==========================================
# RATE LIMITING
# ==========================================

# Rate limits (format: "count/period" e.g., "100/minute")
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=10/hour
RATE_LIMIT_AI=20/minute
RATE_LIMIT_UPLOAD=10/minute

# ==========================================
# CORS (Security)
# ==========================================

# Allowed origins (comma-separated, or * for development)
# Example: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=*

# ==========================================
# DATABASE CONNECTION POOLING
# ==========================================

# Use serverless mode (NullPool) - set to true for Render free tier
USE_SERVERLESS=false

# Connection pool settings (ignored if USE_SERVERLESS=true)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ==========================================
# FILE UPLOADS
# ==========================================

# Maximum file sizes (in MB)
MAX_FILE_SIZE_MB=100
MAX_VIDEO_SIZE_MB=500

# ==========================================
# OPTIONAL SERVICES
# ==========================================

# ElevenLabs Voice ID (default voice)
ELEVENLABS_VOICE_ID=3AMU7jXQuQa3oRvRqUmb

# OpenAI API Key (optional, not currently used)
# OPENAI_API_KEY=sk-your_openai_api_key_here
